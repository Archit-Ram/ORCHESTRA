# ORCHESTRA Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# --- Runtime ---
NODE_ENV=development
ORCHESTRA_ENVIRONMENT=simulator
# Valid: "simulator" | "live"

# --- Server ---
API_PORT=3001
MCP_PORT=3002

# --- AWS Bedrock ---
# Uses standard AWS SDK credential chain (env vars, shared credentials, IAM role).
# Do NOT paste access keys here if using IAM roles or SSO.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Example: anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REQUEST_TIMEOUT_MS=30000
BEDROCK_MAX_RETRIES=3

# --- Logging ---
LOG_LEVEL=info
# Valid: "debug" | "info" | "warn" | "error" | "fatal"

# --- Risk Engine ---
RISK_THRESHOLD_MINUTES=30

# --- User Timezone ---
USER_TIMEZONE=America/Los_Angeles

# --- Live Integration Tests (optional, never required for unit tests) ---
BEDROCK_LIVE_TEST=false
GCAL_LIVE_TEST=false
GMAIL_LIVE_TEST=false
