{
  "name": "orchestra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Promise-Aware Personal AI \u2014 Amazon Developer Hackathon 2026, Alexa+ Track",
  "author": "Archit-Ram",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit -p packages/domain/tsconfig.json",
    "test:unit": "vitest run",
    "build": "pnpm -r run build",
    "validate:env": "tsx scripts/validate-env.ts",
    "clean": "pnpm -r run clean",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
